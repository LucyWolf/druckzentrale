[Desktop Entry]
Type=Application
Name=PrintDock installieren (Debian/Ubuntu)
Comment=Lädt die neueste Version und installiert alles (Pakete, Dienste, Menüeintrag)
Icon=system-software-install
Exec=env DZ_FROM_WEB=1 bash -c "curl -fsSL -o /tmp/PrintDock-installieren.sh https://github.com/LucyWolf/printdock/releases/latest/download/PrintDock-installieren.sh || { kdialog --error \"Download fehlgeschlagen. Besteht eine Internetverbindung?\" || zenity --error --text=\"Download fehlgeschlagen. Besteht eine Internetverbindung?\"; exit 1; }; bash /tmp/PrintDock-installieren.sh"
Terminal=false
Categories=Utility;
