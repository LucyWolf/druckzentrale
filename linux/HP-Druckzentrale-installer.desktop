[Desktop Entry]
Type=Application
Name=HP Druckzentrale installieren
Comment=Lädt die neueste Version und installiert alles (Pakete, Dienste, Menüeintrag)
Icon=system-software-install
Exec=env HPDZ_FROM_WEB=1 bash -c "curl -fsSL -o /tmp/HP-Druckzentrale-installieren.sh https://github.com/LucyWolf/hp-druckzentrale/releases/latest/download/HP-Druckzentrale-installieren.sh || { kdialog --error \"Download fehlgeschlagen. Besteht eine Internetverbindung?\" || zenity --error --text=\"Download fehlgeschlagen. Besteht eine Internetverbindung?\"; exit 1; }; bash /tmp/HP-Druckzentrale-installieren.sh"
Terminal=false
Categories=Utility;
